export default {

  async fetch(request, env) {

    const url = new URL(request.url);

    if(request.method === "GET" && url.pathname === "/"){
      return new Response(HTML,{
        headers:{
          "content-type":"text/html; charset=UTF-8",
          "cache-control":"no-store"
        }
      });
    }

    return new Response(
      JSON.stringify({
        ok:false,
        error:"مسیر پیدا نشد"
      }),
      {

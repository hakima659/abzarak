  }catch(error){

    $("profile").textContent=
      "خطا در دریافت اطلاعات حساب.";

  }

};


window.loadTransactions=async function(){

  try{

    var data=await api(
      "/api/transactions"
    );

    var rows=data.transactions || [];

    if(!rows.length){

      $("transactions").innerHTML=
        "هنوز تراکنشی ثبت نشده است.";

      return;
    }

    var html="<table><thead>"+
      "<tr>"+

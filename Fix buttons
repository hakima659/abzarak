      "<th>مبلغ</th>"+
      "<th>وضعیت</th>"+
      "</tr>"+
      "</thead><tbody>";

    rows.forEach(function(row){

      html+="<tr>"+
        "<td>"+(row.type || "—")+"</td>"+
        "<td>"+
        Number(row.amount || 0)
          .toLocaleString("fa-IR")+
        " تومان</td>"+
